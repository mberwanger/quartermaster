{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/frontmatter.schema.json",
  "title": "Knowledge doc frontmatter",
  "type": "object",
  "required": ["id", "title", "description", "domain", "type", "status", "provenance", "owner"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 320 },
    "domain": { "enum": ["engineering", "product", "growth", "operations"] },
    "type": { "enum": ["concept", "reference", "runbook", "decision", "guide", "policy", "strategy"] },
    "status": { "enum": ["active", "draft", "deprecated", "superseded"] },
    "provenance": { "enum": ["verified", "decided", "asserted"] },
    "owner": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date" },
    "timestamp": { "type": "string", "anyOf": [{ "format": "date" }, { "format": "date-time" }] },
    "last_verified": { "type": "string", "format": "date" },
    "resource": { "type": "string", "format": "uri" },
    "sources": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "properties": { "repo": {"type":"string"}, "path": {"type":"string"}, "linear": {"type":"string"}, "url": {"type":"string","format":"uri"} } }
    },
    "capability": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "visibility": { "enum": ["internal", "restricted"] }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["reference", "runbook"] } } },
      "then": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } } }
  ]
}